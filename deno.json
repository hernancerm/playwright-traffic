{
  "tasks": {
    "check": "deno check cli/main.ts scripts/install.ts",
    "test": "deno test cli",
    "install": "deno run --allow-read --allow-write --allow-env=HOME scripts/install.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": true,
    "exclude": ["playwright/node_modules"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1"
  }
}
