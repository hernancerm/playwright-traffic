{
  "workspace": [
    "./builder",
    "./collection",
    "./reporter"
  ],
  "tasks": {
    "check": "deno check builder/mod.ts collection/cli.ts reporter/main.ts scripts/install.ts",
    "test": "deno test -A",
    "install": "deno run --allow-read --allow-write --allow-env=HOME scripts/install.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": true
  },
  "imports": {
    "@std/path": "jsr:@std/path@1"
  }
}
