{
  "name": "playwright-traffic",
  "version": "0.1.0",
  "description": "Run one Playwright test and print the requests it sent as JSON.",
  "keywords": [
    "playwright",
    "api",
    "testing",
    "http",
    "requests",
    "trace",
    "neovim"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hernancerm/playwright-traffic.git"
  },
  "homepage": "https://github.com/hernancerm/playwright-traffic#readme",
  "bugs": "https://github.com/hernancerm/playwright-traffic/issues",
  "type": "module",
  "bin": {
    "playwright-traffic": "./dist/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/cli/main.js",
    "check": "tsc --noEmit",
    "fmt": "prettier --write .",
    "test": "node --test 'src/**/*.test.ts'",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
