{
  "name": "wirepeek",
  "version": "0.1.0",
  "description": "Run one Playwright test and print the requests it sent as JSON.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "wirepeek": "./dist/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli/main.js",
    "check": "tsc --noEmit",
    "fmt": "prettier --write .",
    "test": "node --test 'src/**/*.test.ts'",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
